local function fetchInventoryForType(userId, assetType, token)
    local items, cursor = {}, nil
    local retries = 0
    repeat
        if token ~= fetchId then return items end
        local url = string.format("https://inventory.roblox.com/v2/users/%d/inventory?assetTypes=%s&limit=100&sortOrder=Asc", userId, HttpService:UrlEncode(assetType))
        if cursor then url = url .. "&cursor=" .. HttpService:UrlEncode(cursor) end
        
        local ok, res = pcall(function() return httpRequest({ Url = url, Method = "GET" }) end)
        
        if ok and res and res.StatusCode == 200 then
            local body = HttpService:JSONDecode(res.Body)
            for _, item in ipairs(body.data or {}) do table.insert(items, item) end
            cursor = body.nextPageCursor
            retries = 0
        else
            retries = retries + 1
            if retries >= 3 then return nil end
            task.wait(1)
        end
        task.wait(0.1)
    until not cursor
    return items
end

local function fetchInventory(userId, token)
    local all, seen = {}, {}
    local assetTypes = {"Asset", "Animation", "Accessory", "Shirt", "Pants", "Face", "Gear"}
    local completed = 0
    local failedCount = 0
    
    for _, assetType in ipairs(assetTypes) do
        task.spawn(function()
            local items = fetchInventoryForType(userId, assetType, token)
            if token ~= fetchId then return end
            
            if items == nil then
                failedCount = failedCount + 1
            else
                for _, item in ipairs(items) do
                    if not seen[item.assetId] then 
                        seen[item.assetId] = true
                        table.insert(all, item) 
                    end
                end
            end
            completed = completed + 1
        end)
    end
    
    while completed < #assetTypes do
        if token ~= fetchId then return all end
        task.wait(0.05)
    end
    
    if failedCount == #assetTypes then return nil end
    return all
end

local function fetchDetails(assetIds, token)
    local result, chunks = {}, {}
    for i = 1, #assetIds, 100 do
        local chunk = {}
        for j = i, math.min(i + 99, #assetIds) do table.insert(chunk, { itemType = "Asset", id = assetIds[j] }) end
        table.insert(chunks, chunk)
    end

    local completed, total = 0, #chunks
    for _, chunk in ipairs(chunks) do
        task.spawn(function()
            if token ~= fetchId then return end
            local ok, res = pcall(function() return httpRequest({ Url = "https://catalog.roblox.com/v1/catalog/items/details", Method = "POST", Headers = { ["Content-Type"] = "application/json" }, Body = HttpService:JSONEncode({ items = chunk }) }) end)
            if ok and res and res.StatusCode == 200 then
                local body = HttpService:JSONDecode(res.Body)
                for _, d in ipairs(body.data or {}) do result[d.id] = d end
            else
                for _, item in ipairs(chunk) do
                    if token ~= fetchId then return end
                    local data = getAssetDetails(item.id)
                    if data.info then
                        result[item.id] = {
                            id = item.id, name = data.info.Name, price = data.price, assetType = formatAssetType(data.info.AssetTypeId),
                            Creator = data.info.Creator, Created = data.info.Created, IsLimited = data.info.IsLimited or data.info.IsLimitedUnique,
                            Description = data.info.Description, isFree = data.isFree, isOffsale = data.isOffsale
                        }
                    end
                end
            end
            completed = completed + 1
        end)
    end
    while completed < total do if token ~= fetchId then return result end; task.wait(0.05) end
    return result
end

local function processPlayer(player, isRich)
    currentPlayer = player
    fetchId = fetchId + 1
    local token = fetchId

    if isRich then
        highlightSelected.Enabled = false
        if player.Character then
            highlightRich.Adornee = player.Character
            highlightRich.Enabled = true
        end
    else
        highlightRich.Enabled = false
        if player.Character then
            highlightSelected.Adornee = player.Character
            highlightSelected.Enabled = true
        end
    end

    panel.Visible = true
    viewportFrame.Visible = true
    
    viewportFrame.Position = UDim2.new(1, -2000, 0.5, 0)
    panel.Position = UDim2.new(1, PANEL_HIDDEN_X, 0.5, 0)
    TweenService:Create(viewportFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), { Position = UDim2.new(1, -480, 0.5, 0) }):Play()
    TweenService:Create(panel, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), { Position = UDim2.new(1, PANEL_SHOWN_X, 0.5, 0) }):Play()

    titleLabel.Text = "INSPECTING  " .. player.DisplayName
    subtitleLabel.Text = "@" .. player.Name

    worldModel:ClearAllChildren()
    rotationY = 0
    
    task.spawn(function()
        local success, character = pcall(function() return Players:CreateHumanoidModelFromUserId(player.UserId) end)
        if success and character and token == fetchId then
            character.Parent = worldModel
            local root = character:FindFirstChild("HumanoidRootPart")
            if root then
                character:PivotTo(CFrame.new(0, 0, 0))
                local light = create("PointLight", { Brightness = 2, Range = 10, Color = Color3.fromRGB(255, 255, 255), Parent = root })
                local light2 = create("PointLight", { Brightness = 1, Range = 10, Color = Color3.fromRGB(255, 255, 255), Parent = root })
                light2.Position = Vector3.new(2, 2, 2)
            end
        end
    end)

    clearList(); allItems = {}; currentWearingIds = {}
    totalLabel.Text = "Inv: R$ 0"; wearingLabel.Text = "Worn: R$ 0"; countLabel.Text = "0 items"

    local loading = create("TextLabel", { Size = UDim2.new(1, -8, 0, 50), BackgroundTransparency = 1, Font = Enum.Font.Gotham, TextSize = 13, TextColor3 = Color3.fromRGB(180, 180, 180), Text = "Fetching inventory...", Parent = listFrame })

    task.spawn(function()
        task.wait(0.1)
        for _, id in ipairs(getEquippedIds(player)) do currentWearingIds[id] = true end

        local items = fetchInventory(player.UserId, token)
        if token ~= fetchId then return end
        
        if items == nil then 
            loading.Text = "Failed to load (API Rate Limit/Error)." 
            return 
        end
        if #items == 0 then 
            loading.Text = "No items found (Private or Empty)."; 
            return 
        end

        loading.Text = "Loading item details..."
        local ids = {}
        for _, item in ipairs(items) do table.insert(ids, item.assetId) end

        local details = fetchDetails(ids, token)
        if token ~= fetchId then return end
        loading:Destroy()

        for _, item in ipairs(items) do
            local d = details[item.assetId]
            local price = d and tonumber(d.price) or 0
            local isFree = d and d.isFree or false
            local isOffsale = d and d.isOffsale or false
            
            table.insert(allItems, {
                assetId = item.assetId,
                name = d and d.name or item.name or "Unknown",
                assetType = d and d.assetType or item.assetType or "Asset",
                price = price,
                isFree = isFree,
                isOffsale = isOffsale,
                rawCreator = d and d.Creator or nil,
                created = d and d.Created or nil,
                isLimited = d and d.IsLimited or false
            })
        end

        if currentSort == "Price (High to Low)" then table.sort(allItems, function(a, b) return a.price > b.price end)
        elseif currentSort == "Price (Low to High)" then table.sort(allItems, function(a, b) return a.price < b.price end)
        else table.sort(allItems, function(a, b) return a.name < b.name end) end

        for i, entry in ipairs(allItems) do
            if token ~= fetchId then return end
            createRow(entry)
            if i % 25 == 0 then task.wait() end
        end
        updateTotal()
    end)
end

