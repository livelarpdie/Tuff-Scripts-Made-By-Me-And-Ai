trackConnection(LocalPlayer.Chatted:Connect(function(msg)
    local args = string.lower(msg)

    if args == "!disable" then
        isScriptActive = not isScriptActive
        if isScriptActive then enableScript() else disableScript() end
    elseif args == "!cmds" then
        cmdsPopup.Visible = true
    elseif args == "!check" then
        enableScript()
        local p = getPlayerUnderMouse(true) -- Fallback to nearest player
        if p then 
            notify("Selected: " .. p.Name)
            processPlayer(p) 
        else
            notify("No players found.")
        end
    elseif args == "!servcheck" then
        enableScript()
        notify("Scanning server...")
        
        local players = Players:GetPlayers()
        
        task.spawn(function()
            local allEquipped = {}
            local uniqueIds = {}
            local idMap = {}
            
            for _, p in ipairs(players) do
                local equipped = getEquippedIds(p)
                allEquipped[p] = equipped
                for _, id in ipairs(equipped) do
                    local strId = tostring(id)
                    if not idMap[strId] then
                        idMap[strId] = true
                        table.insert(uniqueIds, id)
                    end
                end
            end
            
            local prices = {}
            for i = 1, #uniqueIds, 100 do
                local chunk = {}
                for j = i, math.min(i+99, #uniqueIds) do
                    table.insert(chunk, { itemType = "Asset", id = uniqueIds[j] })
                end
                local ok, res = pcall(function() return httpRequest({ Url = "https://catalog.roblox.com/v1/catalog/items/details", Method = "POST", Headers = { ["Content-Type"] = "application/json" }, Body = HttpService:JSONEncode({ items = chunk }) }) end)
                if ok and res and res.StatusCode == 200 then
                    local body = HttpService:JSONDecode(res.Body)
                    for _, d in ipairs(body.data or {}) do
                        local price = d.price or d.lowestPrice or 0
                        prices[tostring(d.id)] = price
                    end
                else
                    for _, item in ipairs(chunk) do
                        prices[tostring(item.id)] = getAssetDetails(item.id).price
                    end
                end
                task.wait(0.1)
            end
            
            local maxItemPrice = -1
            local richestPlayer = nil
            for p, ids in pairs(allEquipped) do
                for _, id in ipairs(ids) do
                    local price = prices[tostring(id)] or 0
                    if price > maxItemPrice then
                        maxItemPrice = price
                        richestPlayer = p
                    end
                end
            end
            
            if richestPlayer then
                notify("Found: " .. richestPlayer.Name .. " (R$ " .. comma(maxItemPrice) .. ")")
                processPlayer(richestPlayer, true) -- true for Green highlight
            else
                notify("No equipped items found.")
            end
        end)
    end
end))

