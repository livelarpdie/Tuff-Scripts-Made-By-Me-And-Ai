local camDistance = 8
local targetHeight = 1.5
local currentAngle = 0
local rotationY = 0
local isDragging, autoSpin = false, true
local lastDragX, lastDragY = 0, 0

trackConnection(viewportFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        isDragging = true; autoSpin = false
        lastDragX, lastDragY = input.Position.X, input.Position.Y
    end
end))
trackConnection(UserInputService.InputChanged:Connect(function(input)
    if isDragging and input.UserInputType == Enum.UserInputType.MouseMovement then
        local deltaX = input.Position.X - lastDragX
        local deltaY = input.Position.Y - lastDragY
        currentAngle = currentAngle - deltaX * 1.5
        rotationY = math.clamp(rotationY + deltaY * 0.05, -5, 5)
        lastDragX, lastDragY = input.Position.X, input.Position.Y
    end
end))
trackConnection(UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        isDragging = false
        task.delay(1.5, function() if not isDragging then autoSpin = true end end)
    end
end))

trackConnection(RunService.RenderStepped:Connect(function(dt)
    if viewportFrame.Visible and autoSpin and not isDragging then
        currentAngle = currentAngle + dt * 45
    end
    local camX = math.sin(math.rad(currentAngle)) * camDistance
    local camZ = math.cos(math.rad(currentAngle)) * camDistance
    local camY = targetHeight + rotationY
    viewportCamera.CFrame = CFrame.lookAt(Vector3.new(camX, camY, camZ), Vector3.new(0, 0, 0))
end))

