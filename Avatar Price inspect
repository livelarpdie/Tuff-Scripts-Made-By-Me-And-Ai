local function create(className, props, parent)
    local obj = Instance.new(className)
    for k, v in pairs(props or {}) do obj[k] = v end
    if parent then obj.Parent = parent end
    return obj
end

local function comma(n)
    n = math.floor(tonumber(n) or 0)
    local s = tostring(n)
    local out = ""
    while #s > 3 do
        out = "," .. s:sub(-3) .. out
        s = s:sub(1, -4)
    end
    return s .. out
end

local function formatAssetType(typeId)
    local types = {
        [8] = "Hat", [41] = "Hair", [42] = "Face", [43] = "Neck", [44] = "Shoulder",
        [45] = "Front", [46] = "Back", [47] = "Waist", [11] = "Shirt", [12] = "Pants",
        [2] = "T-Shirt", [18] = "Face", [19] = "Gear", [24] = "Animation", [48] = "ClimbAnimation",
        [49] = "DeathAnimation", [50] = "FallAnimation", [51] = "IdleAnimation",
        [52] = "JumpAnimation", [53] = "RunAnimation", [54] = "SwimAnimation", [61] = "EmoteAnimation"
    }
    return types[typeId] or "Asset"
end

local priceCache = {}

local function getAssetDetails(assetId)
    if priceCache[assetId] then return priceCache[assetId] end
    local success, info = pcall(function() return MarketplaceService:GetProductInfo(assetId) end)
    if success and info then
        local price = info.PriceInRobux or 0
        local isFree = false
        local isOffsale = not info.IsForSale
        
        if info.IsForSale and price == 0 and not (info.IsLimited or info.IsLimitedUnique) then
            isFree = true
        end
        
        if (info.IsLimited or info.IsLimitedUnique) and price == 0 then
            local rapOk, rapRes = pcall(function() return httpRequest({ Url = string.format("https://economy.roblox.com/v1/assets/%d/resale-data", assetId), Method = "GET" }) end)
            if rapOk and rapRes and rapRes.StatusCode == 200 then
                local rapBody = HttpService:JSONDecode(rapRes.Body)
                price = tonumber(rapBody.recentAveragePrice) or 0
            end
        end
        
        local result = { price = price, isFree = isFree, isOffsale = isOffsale, info = info }
        priceCache[assetId] = result
        return result
    end
    return { price = 0, isFree = false, isOffsale = true, info = nil }
end

local function getEquippedIds(player)
    local ids = {}
    local success, appearance = pcall(function() return Players:GetCharacterAppearanceInfoAsync(player.UserId) end)
    if success and appearance and appearance.assets then
        for _, asset in ipairs(appearance.assets) do
            table.insert(ids, asset.id)
        end
    end
    return ids
end

-- ============================================================
-- RAYCAST / SELECTION LOGIC
-- ============================================================
local function getPlayerUnderMouse(fallbackToNearest)
    local function castRay(x, y)
        local ray = Camera:ViewportPointToRay(x, y)
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = { LocalPlayer.Character }

        local result = workspace:Raycast(ray.Origin, ray.Direction * 1000, params)
        if result then
            local part = result.Instance
            while part and part ~= workspace do
                if part:IsA("Model") and part:FindFirstChildOfClass("Humanoid") then
                    local plr = Players:GetPlayerFromCharacter(part)
                    if plr and plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then 
                        return plr 
                    end
                end
                part = part.Parent
            end
        end
        return nil
    end

    -- 1. Try mouse position
    local p = castRay(Mouse.X, Mouse.Y)
    
    -- 2. If mouse fails and we are typing in chat, try center of screen
    if not p and UserInputService:GetFocusedTextBox() then
        p = castRay(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    end
    
    -- 3. If still no player and fallback is requested, find the nearest player
    if not p and fallbackToNearest then
        local nearestDist = math.huge
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                local dist = (plr.Character.HumanoidRootPart.Position - LocalPlayer.Character.HumanoidRootPart.Position).Magnitude
                if dist < nearestDist then
                    nearestDist = dist
                    p = plr
                end
            end
        end
    end
    return p
end

trackConnection(RunService.RenderStepped:Connect(function()
    local p = getPlayerUnderMouse(false)
    hoveredPlayer = p

    if not isScriptActive then return end

    -- Handle Hover Highlight (White)
    if p and p ~= currentPlayer and p.Character then
        highlightHover.Adornee = p.Character
        highlightHover.Enabled = true
    else
        highlightHover.Enabled = false
    end

    -- Handle Selection Highlight (Red)
    if currentPlayer and currentPlayer.Character then
        if highlightRich.Adornee == currentPlayer.Character and highlightRich.Enabled then
            highlightSelected.Enabled = false
        else
            highlightSelected.Adornee = currentPlayer.Character
            highlightSelected.Enabled = true
        end
    else
        highlightSelected.Enabled = false
    end
end))

