        if child:IsA("Frame") or child:IsA("TextLabel") then child:Destroy() end
    end
    rows = {}
end

local function updateTotal()
    local total, count, wearingTotal = 0, 0, 0
    for _, row in ipairs(rows) do
        if row.Visible then
            local p = row:GetAttribute("ItemPrice") or 0
            total = total + p
            if row:GetAttribute("IsWorn") then wearingTotal = wearingTotal + p end
            count = count + 1
        end
    end
    totalLabel.Text = "Inv: R$ " .. comma(total)
    wearingLabel.Text = "Worn: R$ " .. comma(wearingTotal)
    countLabel.Text = count .. " items"
end

