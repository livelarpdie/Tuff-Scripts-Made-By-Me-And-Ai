    topSlash.Size = UDim2.new(0, 2, 0, 28)
    topSlash.AnchorPoint = Vector2.new(0.5, 0.5)
    topSlash.Position = UDim2.new(0.5, 0, 0.5, 0)
    topSlash.Rotation = -45
    topSlash.BackgroundColor3 = Color3.fromRGB(255, 65, 65)
    topSlash.BorderSizePixel = 0
    topSlash.Visible = false
    topSlash.ZIndex = 3
    topSlash.Parent = topBtn

    local topSlashCorner = Instance.new("UICorner")
    topSlashCorner.CornerRadius = UDim.new(1, 0)
    topSlashCorner.Parent = topSlash

    ----------------------------------------------------------------
    -- sync both UIs from a single source of truth
    ----------------------------------------------------------------
    table.insert(syncCallbacks, function(muted)
        -- pill
        slash.Visible = muted
        label.Text = muted and "Muted" or "Live"

        TweenService:Create(pill, TWEEN_INFO, {
            BackgroundColor3 = muted
                and Color3.fromRGB(30, 30, 30)
                or  Color3.fromRGB(0, 0, 0)
        }):Play()

        TweenService:Create(micIcon, TWEEN_INFO, {
            ImageColor3 = muted
                and Color3.fromRGB(160, 160, 160)
                or  Color3.fromRGB(255, 255, 255)
        }):Play()

        -- top-left button
        topSlash.Visible = muted

        TweenService:Create(topBtn, TWEEN_INFO, {
            BackgroundColor3 = muted
                and Color3.fromRGB(30, 30, 30)
                or  Color3.fromRGB(0, 0, 0)
        }):Play()

        TweenService:Create(topIcon, TWEEN_INFO, {
            ImageColor3 = muted
                and Color3.fromRGB(160, 160, 160)
                or  Color3.fromRGB(255, 255, 255)
        }):Play()
    end)

    ----------------------------------------------------------------
    -- pill drag + click
    ----------------------------------------------------------------
    local dragStart = nil
    local startPos  = nil
    local wasDrag   = false
    local DRAG_THRESHOLD = 6

    btn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragStart = input.Position
            startPos  = pill.Position
            wasDrag   = false
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragStart and (
            input.UserInputType == Enum.UserInputType.MouseMovement or
            input.UserInputType == Enum.UserInputType.Touch
        ) then
            local delta = input.Position - dragStart
            if not wasDrag and delta.Magnitude > DRAG_THRESHOLD then
                wasDrag = true
            end
            if wasDrag then
                pill.Position = UDim2.new(
                    startPos.X.Scale,
                    startPos.X.Offset + delta.X,
                    startPos.Y.Scale,
                    startPos.Y.Offset + delta.Y
                )
            end
        end
    end)

    btn.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            if not wasDrag then
                setMute(not Objects.Muted)
            end
            dragStart = nil
            wasDrag   = false
        end
    end)

    ----------------------------------------------------------------
    -- top-left button click
    ----------------------------------------------------------------
    topBtn.MouseButton1Click:Connect(function()
        setMute(not Objects.Muted)
    end)

    topBtn.MouseEnter:Connect(function()
        TweenService:Create(topBtn, TWEEN_INFO, {
            BackgroundTransparency = Objects.Muted and 0.35 or 0.15
        }):Play()
    end)
    topBtn.MouseLeave:Connect(function()
        TweenService:Create(topBtn, TWEEN_INFO, {
            BackgroundTransparency = 0.35
        }):Play()
    end)

    ----------------------------------------------------------------
    -- M key stays in sync
    ----------------------------------------------------------------
    UserInputService.InputBegan:Connect(function(input, gp)
        if gp then return end
        if input.KeyCode == Enum.KeyCode.M then
            setMute(not Objects.Muted)
        end
    end)
end

