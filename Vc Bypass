local SPEAKING_THRESHOLD = 0.01
local TAG = "VoiceIndicator"

local TWEEN_IN  = TweenInfo.new(0.1,  Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local TWEEN_OUT = TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

local function makeIndicator(character)
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local existing = hrp:FindFirstChild(TAG)
    if existing then existing:Destroy() end

    local billboard = Instance.new("BillboardGui")
    billboard.Name = TAG
    billboard.Size = UDim2.new(0, 44, 0, 44)
    billboard.StudsOffset = Vector3.new(0, 2.5, 0)
    billboard.AlwaysOnTop = false
    billboard.ResetOnSpawn = false
    billboard.LightInfluence = 0
    billboard.Parent = hrp

    local circle = Instance.new("Frame")
    circle.Size = UDim2.new(1, 0, 1, 0)
    circle.AnchorPoint = Vector2.new(0.5, 0.5)
    circle.Position = UDim2.new(0.5, 0, 0.5, 0)
    circle.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    circle.BackgroundTransparency = 1
    circle.BorderSizePixel = 0
    circle.Parent = billboard

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(1, 0)
    corner.Parent = circle

    local icon = Instance.new("ImageLabel")
    icon.Size = UDim2.new(0.6, 0, 0.6, 0)
    icon.AnchorPoint = Vector2.new(0.5, 0.5)
    icon.Position = UDim2.new(0.5, 0, 0.5, 0)
    icon.BackgroundTransparency = 1
    icon.Image = "rbxassetid://6031068420"
    icon.ImageColor3 = Color3.fromRGB(255, 255, 255)
    icon.ImageTransparency = 1
    icon.Parent = circle

    return circle, icon
end

local function hookPlayer(player)
    if player == Self then return end

    local function onCharacter(character)
        character:WaitForChild("HumanoidRootPart", 10)

        local circle, icon = makeIndicator(character)
        if not circle then return end

        local analyzer, wire, conn = nil, nil, nil
        local speaking = false

        local function setupAnalyzer()
            local input = player:FindFirstChildOfClass("AudioDeviceInput")
            if not input then return end
            if analyzer then analyzer:Destroy() end
            if wire then wire:Destroy() end

            analyzer = Instance.new("AudioAnalyzer")
            analyzer.Parent = player

            wire = Instance.new("Wire")
            wire.SourceInstance = input
            wire.TargetInstance = analyzer
            wire.Parent = player
        end

        setupAnalyzer()

        player.ChildAdded:Connect(function(child)
            if child:IsA("AudioDeviceInput") then
                task.wait(0.1)
                setupAnalyzer()
            end
        end)

        conn = RunService.Heartbeat:Connect(function()
            if not character.Parent then
                conn:Disconnect()
                if analyzer then analyzer:Destroy() end
                if wire then wire:Destroy() end
                return
            end

            if not analyzer then return end
            local level = analyzer.PeakLevel
            local isSpeaking = level > SPEAKING_THRESHOLD

            if isSpeaking and not speaking then
                speaking = true
                TweenService:Create(circle, TWEEN_IN, {
                    BackgroundTransparency = 0.35
                }):Play()
                TweenService:Create(icon, TWEEN_IN, {
                    ImageTransparency = 0
                }):Play()

            elseif not isSpeaking and speaking then
                speaking = false
                TweenService:Create(circle, TWEEN_OUT, {
                    BackgroundTransparency = 1
                }):Play()
                TweenService:Create(icon, TWEEN_OUT, {
                    ImageTransparency = 1
                }):Play()
            end
        end)
    end

    if player.Character then
        task.spawn(onCharacter, player.Character)
    end
    player.CharacterAdded:Connect(onCharacter)
end

local function startIndicators()
    for _, p in Live:GetPlayers() do
        task.spawn(hookPlayer, p)
    end
    Live.PlayerAdded:Connect(hookPlayer)
end

-- ── bypass ────────────────────────────────────────────────────────
local function Bypass()
    VoiceChatInternal.PublishPause(VoiceChatInternal, false)
    task.wait(4)

    VoiceChatService.leaveVoice(VoiceChatService)
    task.wait(2)

    Objects.DisabledConns = getconnections(VoiceChatInternal.StateChanged)
    for _, conn in pairs(Objects.DisabledConns) do
        conn:Disable()
    end

    Objects.StateConn = VoiceChatInternal.StateChanged:Connect(function(old, new)
        if tostring(new):find("Joined") then
            Objects.Sucess = true
        end
    end)

    task.wait(1)
    VoiceChatService.joinVoice(VoiceChatService)
    task.wait(3)

    if not Objects.Sucess then
        if Objects.StateConn then Objects.StateConn:Disable() Objects.StateConn = nil end
        for _, c in pairs(Objects.DisabledConns) do pcall(function() c:Enable() end) end
        Objects.DisabledConns = {}
        return false
    end

    Objects.Muted = false
    print("Finished")

    buildMuteUI()
    startIndicators()
    return true
end

