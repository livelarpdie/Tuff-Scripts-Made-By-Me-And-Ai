-- ── mute state checker ────────────────────────────────────────────
local function isMuted()
    if Objects.Muted then return true end
    local muted = false
    pcall(function()
        if VoiceChatInternal then
            if VoiceChatInternal.IsPublishPaused then
                muted = VoiceChatInternal:IsPublishPaused()
            elseif VoiceChatInternal.GetMuteState then
                local state = VoiceChatInternal:GetMuteState()
                muted = (state == Enum.MuteState.Muted)
            end
        end
    end)
    return muted
end

-- ── local mic analyzer ────────────────────────────────────────────
local SetupAudio = function()
    pcall(function()
        for _, child in pairs(Self:GetChildren()) do
            if child.Name == "NewAnalyzer" or child.Name == "NewWire" then
                child:Destroy()
            end
        end

        local Input = Self:FindFirstChildOfClass("AudioDeviceInput")
        if not Input then
            Input = Instance.new("AudioDeviceInput")
            Input.Player = Self
            Input.Parent = Self
        end

        local Analyzer = Instance.new("AudioAnalyzer")
        Analyzer.Name = "NewAnalyzer"
        Analyzer.Parent = Self

        local Wire = Instance.new("Wire")
        Wire.Name = "NewWire"
        Wire.SourceInstance = Input
        Wire.TargetInstance = Analyzer
        Wire.Parent = Self

        Objects.Analyzer = Analyzer
    end)
end

task.spawn(SetupAudio)

