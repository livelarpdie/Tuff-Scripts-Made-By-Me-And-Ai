    btn.Text = ""
    btn.ZIndex = 5
    btn.Parent = pill

    local TWEEN_INFO = TweenInfo.new(0.15, Enum.EasingStyle.Quad)

    ----------------------------------------------------------------
    -- top-left button (replaces default mic indicator location)
    ----------------------------------------------------------------
    local topBtn = Instance.new("TextButton")
    topBtn.Name = "TopMuteButton"
    topBtn.Size = UDim2.new(0, 40, 0, 40)
